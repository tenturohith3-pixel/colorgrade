# ---------------------------------------------------------------------------
# Effectcraft environment
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public Supabase values (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's newer publishable key name is also supported as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in auth redirects, Open Graph, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated admin emails. Admin access also requires profiles.role = 'admin'.
ADMIN_EMAILS=

# Optional: enables the grounded AI assistant.
# Any OpenAI-compatible chat-completions endpoint works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=900

# Optional: set to "false" to disable the read-only catalogue preview when
# Supabase is not configured.
EFFECTCRAFT_PREVIEW_MODE=true

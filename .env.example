[TEMPLATE]

# Access Key System (required for key generation and validation)
# Generate with: openssl rand -base64 32
TOKEN_SECRET=your-secret-key-here

# Admin Panel (required to access /admin)
ADMIN_SECRET=your-admin-password-here

# Optional: Supabase (only needed if you use Stripe webhook for payments)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
